---
// A generic stock-photo skyline in flat shapes: a pale far row, then a darker near row.
const buildings = [
  { left: 0, width: 13, height: 52, tone: 'far' },
  { left: 11, width: 9, height: 66, tone: 'far' },
  { left: 24, width: 12, height: 74, tone: 'far' },
  { left: 41, width: 10, height: 88, tone: 'far', roof: 'spire' },
  { left: 56, width: 14, height: 70, tone: 'far' },
  { left: 72, width: 10, height: 80, tone: 'far' },
  { left: 86, width: 14, height: 58, tone: 'far' },
  { left: 5, width: 12, height: 34, tone: 'near' },
  { left: 17, width: 15, height: 48, tone: 'near', roof: 'slant' },
  { left: 32, width: 11, height: 30, tone: 'near' },
  { left: 43, width: 16, height: 56, tone: 'near' },
  { left: 59, width: 13, height: 38, tone: 'near' },
  { left: 72, width: 17, height: 50, tone: 'near', roof: 'slant' },
  { left: 89, width: 11, height: 28, tone: 'near' },
];

// One fictional mandate, shown both ways. Before buries it in a paragraph; After answers a
// banker's three questions: does my deal fit, has this firm done a similar deal, who do I call?
const answers = [
  { label: 'Criteria', value: '$3–8M EBITDA', detail: 'Founder-owned industrial services' },
  { label: 'Recent investment', value: 'Calder & Pine Mechanical', detail: 'Commercial HVAC services' },
  { label: 'New opportunities', value: 'Jordan Avery', detail: 'Principal', link: 'Email Jordan' },
];
---

<div class="browser" data-browser-mock>
  <fieldset class="toggle">
    <legend class="vh">Show the homepage before or after a redesign</legend>
    <label class="tab">
      <input type="radio" name="browser-view" value="before" autocomplete="off" />
      <span>Before</span>
    </label>
    <label class="tab">
      <input type="radio" name="browser-view" value="after" autocomplete="off" checked />
      <span>After</span>
    </label>
  </fieldset>

  <div
    class="window"
    role="img"
    aria-label="Illustration: the homepage of Your Firm Capital, a fictional firm. Before, a dated page buries its criteria, a past investment and its deal contact in one long paragraph. After, a redesign sets them out at a glance: founder-owned industrial services companies with 3 to 8 million dollars of EBITDA, a recent investment in Calder & Pine Mechanical, and Jordan Avery, Principal, for new opportunities."
  >
    <div class="chrome">
      <span class="lights"><span></span><span></span><span></span></span>
      <div class="address">
        <span class="scheme">https://</span><span class="domain" data-browser-address>yourfirm.com</span>
      </div>
    </div>

    <div class="viewport">
      <div class="view before">
        <p class="b-banner">YOUR FIRM CAPITAL</p>
        <p class="b-nav"><u>Home</u> | <u>About Us</u> | <u>Team</u> | <u>Portfolio</u> | <u>Contact Us</u></p>
        <div class="b-body">
          <div class="b-photo">
            {buildings.map((b) => (
              <span
                class:list={['building', b.tone, b.roof]}
                style={`left:${b.left}%;width:${b.width}%;height:${b.height}%`}
              />
            ))}
            <span class="b-ground"></span>
          </div>
          <div class="b-text">
            <p><b>Welcome to our website.</b></p>
            <p>
              Your Firm Capital is a private investment firm that partners with business owners and
              management teams to build long-term value. The firm seeks to invest in founder-owned
              industrial services businesses with EBITDA of $3 million to $8 million. Past investments
              include Calder &amp; Pine Mechanical, a provider of commercial HVAC services. Investment
              opportunities may be directed to Jordan Avery, Principal.
            </p>
            <p>For more information please contact us.</p>
          </div>
        </div>
        <p class="b-foot">Your Firm Capital. All rights reserved.</p>
      </div>

      <div class="view after">
        <div class="a-nav">
          <span class="a-mark">Your Firm Capital</span>
          <span class="a-links"><span>Criteria</span><span>Portfolio</span><span>Team</span></span>
        </div>
        <div class="a-band">
          <svg class="a-land" viewBox="0 0 640 200" preserveAspectRatio="xMaxYMax slice">
            <circle class="land-sun" cx="540" cy="92" r="24"></circle>
            <path class="land-far" d="M0 130C80 100 150 110 220 125S360 80 440 105S580 120 640 95V200H0Z"></path>
            <path class="land-mid" d="M0 165C100 130 190 150 280 160S470 125 640 150V200H0Z"></path>
            <path class="land-near" d="M0 190C120 170 260 185 380 180S560 170 640 185V200H0Z"></path>
          </svg>
          <p class="a-hero">Backing founder-owned industrial services companies.</p>
        </div>
        <div class="a-answers">
          {answers.map((answer) => (
            <div class="a-answer">
              <p class="a-label">{answer.label}</p>
              <p class="a-value">{answer.value}</p>
              <p class="a-detail">
                {answer.detail}
                {answer.link && <span class="a-link">{answer.link}</span>}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <p class="caption">Illustrative redesign for a fictional firm.</p>
</div>

<script>
  // The fade is switched on at the first switch, not on load: if the page's first style pass runs
  // before the stylesheet applies, a fade that is already on makes Before fade out on load.
  const mock = document.querySelector<HTMLElement>('[data-browser-mock]');
  mock?.addEventListener('change', () => mock.classList.add('can-fade'), { once: true });
</script>

<style>
  /*
   * WCAG AA contrast for the colors only this illustration uses (the dated site's own palette):
   *   #FFFFFF on #1F2F5C  12.97   banner
   *   #0000B8 on #D9D9D9   8.79   nav links
   *   #000000 on #FFFFFF  21.00   body text
   *   #595959 on #FFFFFF   7.00   footer
   * The landscape adds two greens between the tokens. Its headline passes on every tone it can
   * cross: --paper on --accent 8.54, on #2B5F49 6.56, on #173B2D 10.95, on --ink 15.74. It stays
   * clear of the sun, which is --paper.
   * Everything else uses the tokens in global.css.
   */
  /* In the split hero the window stretches to match the text column's height. */
  .browser {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Radios, so the toggle works without JavaScript. */
  .toggle {
    display: flex;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .tab {
    position: relative;
    display: block;
    margin-left: -1px;
    cursor: pointer;
  }

  .tab:first-of-type {
    margin-left: 0;
  }

  .tab input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .tab span {
    display: block;
    min-width: 5rem;
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    text-align: center;
    border: 1px solid var(--ink);
    border-bottom: 0;
  }

  .tab input:checked + span {
    color: var(--paper);
    background: var(--ink);
  }

  .tab input:focus-visible + span {
    position: relative;
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .window {
    display: flex;
    flex: 1;
    flex-direction: column;
    border: 1px solid var(--ink);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    background: var(--paper-2);
    border-bottom: 1px solid var(--ink);
  }

  .lights {
    display: flex;
    flex: none;
    gap: 0.3125rem;
  }

  .lights span {
    width: 0.625rem;
    height: 0.625rem;
    border: 1px solid var(--ink-2);
  }

  .address {
    display: flex;
    flex: 1;
    min-width: 0;
    padding: 0.25rem 0.625rem;
    font-size: 0.875rem;
    line-height: 1.4;
    background: var(--paper);
    border: 1px solid var(--ink-2);
  }

  .scheme {
    flex: none;
    color: var(--ink-2);
  }

  .domain {
    overflow: hidden;
    color: var(--ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Both versions share one cell, so the window keeps its height when it flips. */
  .viewport {
    display: grid;
    flex: 1;
    container-type: inline-size;
    overflow: hidden;
  }

  /* 12px at the smallest, so both views stay legible on a phone. */
  .view {
    display: flex;
    flex-direction: column;
    grid-area: 1 / 1;
    min-width: 0;
    font-size: clamp(0.75rem, 2.2cqw, 1rem);
    visibility: hidden;
    opacity: 0;
  }

  .browser:has(input[value='before']:checked) .before,
  .browser:has(input[value='after']:checked) .after {
    visibility: visible;
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .browser.can-fade .view {
      transition:
        opacity 0.7s ease,
        visibility 0.7s;
    }
  }

  /* Before: the dated site */
  .before {
    font-family: 'Times New Roman', Times, serif;
    line-height: 1.12;
    color: #000000;
    background: #FFFFFF;
  }

  .b-banner {
    padding: 0.5em 0.625em;
    font-size: 1.375em;
    font-weight: 700;
    color: #FFFFFF;
    background: #1F2F5C;
  }

  .b-nav {
    padding: 0.25em 0.625em;
    color: #0000B8;
    background: #D9D9D9;
  }

  .b-body {
    display: grid;
    flex: 1;
    grid-template-columns: 42% minmax(0, 1fr);
    gap: 0.625em;
    padding: 0.625em;
  }

  .b-photo {
    position: relative;
    align-self: start;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #A9BCCC;
  }

  .building {
    position: absolute;
    bottom: 0;
  }

  .far {
    background: #8195AA;
  }

  .near {
    background: #3F5168;
  }

  .spire {
    clip-path: polygon(50% 0, 56% 16%, 100% 16%, 100% 100%, 0 100%, 0 16%, 44% 16%);
  }

  .slant {
    clip-path: polygon(0 14%, 100% 0, 100% 100%, 0 100%);
  }

  .b-ground {
    position: absolute;
    inset: auto 0 0;
    height: 8%;
    background: #2C3A4C;
  }

  .b-text p + p {
    margin-top: 0.4em;
  }

  .b-foot {
    padding: 0.25em 0.625em 0.5em;
    font-size: 0.9375em;
    color: #595959;
    border-top: 1px solid #D9D9D9;
  }

  /* After: the same firm, in the Celnu style */
  .after {
    color: var(--ink);
    background: var(--paper);
  }

  .a-nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1em;
    padding: 0.75em 1.5em;
  }

  .a-mark {
    font-family: var(--font-display);
    font-size: 1.5em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .a-links {
    display: flex;
    gap: 1em;
    font-size: 0.9375em;
  }

  .a-band {
    position: relative;
    flex: 1;
    min-height: max(10em, 22cqw); /* tall enough that the landscape's crop keeps the whole sun */
    background: var(--accent);
  }

  .a-land {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .land-sun {
    fill: var(--paper);
  }

  .land-far {
    fill: #2B5F49;
  }

  .land-mid {
    fill: #173B2D;
  }

  .land-near {
    fill: var(--ink);
  }

  .a-hero {
    position: relative;
    max-width: 62%;
    padding: 0.4em 0 0.8em 0.55em;
    font-family: var(--font-display);
    font-size: 2.5em;
    line-height: 1;
    letter-spacing: -0.012em;
    color: var(--paper);
    text-wrap: balance;
  }

  /* Three answers a banker looks for, each a label, the fact, and one line of detail. */
  .a-answers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25em;
    padding: 1.25em 1.5em 1.5em;
  }

  .a-label {
    font-size: 1em;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink-2);
  }

  .a-value {
    margin-top: 0.25em;
    font-family: var(--font-display);
    font-size: 1.75em;
    line-height: 1.05;
  }

  .a-detail {
    margin-top: 0.3em;
    font-size: 1em;
    line-height: 1.3;
    color: var(--ink-2);
  }

  .a-link {
    display: block;
    color: var(--accent);
    text-decoration: underline;
  }

  .caption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  /* A phone-width window: the answers become rows, label at left. */
  @container (max-width: 30rem) {
    .a-hero {
      max-width: 74%;
      font-size: 2em;
    }

    .a-answers {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding: 0.25em 1em 0.5em;
    }

    .a-answer {
      display: grid;
      grid-template-columns: 8.5em minmax(0, 1fr);
      column-gap: 0.75em;
      align-items: baseline;
      padding-block: 0.6em;
    }

    .a-answer + .a-answer {
      border-top: 1px solid var(--rule);
    }

    .a-label {
      grid-row: span 2;
      font-size: 0.9375em;
    }

    .a-detail {
      font-size: 0.9375em;
    }

    .a-value {
      margin-top: 0;
      font-size: 1.375em;
    }

    .b-body {
      grid-template-columns: 34% minmax(0, 1fr);
    }
  }
</style>
