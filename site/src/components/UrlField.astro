---
import { CONTACT_EMAIL } from '../config';

interface Props {
  /** Unique per page: this element appears more than once. */
  id: string;
}

const { id } = Astro.props;
const noteId = `${id}-note`;
const errorId = `${id}-error`;
---

<div class="url-field">
  <form class="form" data-url-form novalidate>
    <label class="label" for={id}>Your firm’s website</label>
    <div class="bar">
      <span class="prefix" aria-hidden="true">https://</span>
      <input
        class="input"
        id={id}
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        autocapitalize="none"
        spellcheck="false"
        placeholder="yourfirm.com"
        aria-describedby={`${errorId} ${noteId}`}
      />
      <button class="send" type="submit">Send</button>
    </div>
    <p class="error" id={errorId} role="alert" data-url-error></p>
  </form>
  <p class="fallback"><a href={`mailto:${CONTACT_EMAIL}`}>Email {CONTACT_EMAIL}</a></p>
  <p class="note" id={noteId}>Opens your email. Nothing is sent until you hit send.</p>
</div>

<script>
  import { CONTACT_EMAIL } from '../config';
  import { buildMailto, cleanUrl, domainOf } from '../mailto';

  const address = document.querySelector<HTMLElement>('[data-browser-address]');
  const defaultAddress = address?.textContent ?? '';

  document.querySelectorAll<HTMLFormElement>('[data-url-form]').forEach((form) => {
    const input = form.querySelector('input')!;
    const error = form.querySelector<HTMLElement>('[data-url-error]')!;

    const clearError = () => {
      error.textContent = '';
      input.removeAttribute('aria-invalid');
    };

    input.addEventListener('input', () => {
      clearError();
      if (address) address.textContent = domainOf(cleanUrl(input.value)) || defaultAddress;
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const url = cleanUrl(input.value);
      if (!url) {
        error.textContent = 'Enter your firm’s website first.';
        input.setAttribute('aria-invalid', 'true');
        input.focus();
        return;
      }
      clearError();
      window.location.href = buildMailto(CONTACT_EMAIL, url);
    });
  });
</script>

<style>
  .url-field {
    max-width: 34rem;
  }

  /* Without JavaScript the form can't build the email, so only the plain link shows. */
  .form {
    display: none;
  }

  :global(.js) .form {
    display: block;
  }

  :global(.js) .fallback {
    display: none;
  }

  .label {
    display: block;
    margin-bottom: 0.375rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  /* Border is --ink-2, not --rule: a control's boundary needs 3:1 (5.70 on --paper). */
  .bar {
    display: flex;
    align-items: stretch;
    background: var(--paper);
    border: 1px solid var(--ink-2);
  }

  .bar:has(.input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .prefix {
    display: flex;
    align-items: center;
    padding-left: 0.75rem;
    color: var(--ink-2);
    user-select: none;
  }

  .input {
    flex: 1;
    width: 100%; /* drops the input's intrinsic width, which otherwise overflows at 360px */
    min-width: 0;
    padding: 0.75rem 0.75rem 0.75rem 0.0625rem;
    font: inherit;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-radius: 0;
    appearance: none;
  }

  .input:focus-visible {
    outline: none;
  }

  .input::placeholder {
    color: var(--ink-2);
    opacity: 1;
  }

  .send {
    padding: 0.75rem 1.25rem;
    font: inherit;
    font-weight: 500;
    color: var(--paper);
    background: var(--accent);
    border: 0;
    border-radius: 0;
    cursor: pointer;
  }

  .send:hover {
    background: var(--ink);
  }

  .error:not(:empty) {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .note {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
</style>
