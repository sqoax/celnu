---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BrowserMock from '../components/BrowserMock.astro';
import UrlField from '../components/UrlField.astro';
import { CONTACT_EMAIL } from '../config';
import hiatt from '../assets/hiatt.jpg';

const promise =
  'I rebuild your website around the content you already have (your team, criteria and deals) so owners and bankers can find what they need in seconds, on any device. You don’t write anything new, and you approve every word.';

const offer =
  'I’ll design a free homepage concept from it. You’ll see it within a week, before you decide whether to hire me.';

const included = [
  'Team and bio pages',
  'A searchable portfolio and deal history',
  'Your investment criteria, laid out clearly',
  'On a phone, a banker can check your criteria, find a deal and email the right person',
  'Launch coordinated with your IT provider, so your email keeps working',
  'You own everything, and updates are a quick email to me',
];

const steps = [
  'Send your URL. I capture your whole current site (every page, bio, deal and criterion) so nothing is lost in the move.',
  'See your homepage concept within a week.',
  'Fixed quote after a short call.',
  'Content and compliance review: your team approves everything, and I never write performance figures or investor claims.',
  'Build and launch in about four weeks, coordinated with your IT provider.',
  'Optional ongoing care.',
];

const year = new Date().getFullYear();
---

<Base title="Celnu — Websites for private investment firms" description={promise}>
  <a class="skip" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap header-row">
      <span class="wordmark">Celnu</span>
      <a href="#send" data-jump-to-field>Request a free concept</a>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap columns">
        <div>
          <h1 class="hero-title" id="hero-title">Websites for private investment firms.</h1>
          <p class="subline">{promise}</p>
          <p class="offer">{offer}</p>
          <div class="hero-field" id="send">
            <UrlField id="url-hero" />
          </div>
          <p class="reply">
            Already received a concept from me? Reply to my email with anything you’d like me to
            change.
          </p>
        </div>
        <BrowserMock />
      </div>
    </section>

    <div class="band accent">
      <div class="wrap columns">
        <section aria-labelledby="problem">
          <h2 class="eyebrow" id="problem">01 The problem</h2>
          <p class="statement">
            When a banker sends an owner your name, can they see what you invest in, who they’d work
            with, and which businesses you’ve backed?
          </p>
          <p class="prose">
            Too often they find a dated site, missing bios, a portfolio no one can search, a mobile
            view that falls apart.
          </p>
        </section>
        <section aria-labelledby="who">
          <h2 class="eyebrow" id="who">02 Who it’s for</h2>
          <p class="feature">
            I design and build sites for private equity and private credit funds, SBIC lenders and
            independent sponsors.
          </p>
        </section>
      </div>
    </div>

    <div class="band">
      <div class="wrap columns">
        <section aria-labelledby="included">
          <h2 class="eyebrow" id="included">03 Typical scope</h2>
          <ul class="rows" role="list">
            {included.map((item) => <li>{item}</li>)}
          </ul>
          <p class="prose">
            Your existing content is the starting point. New copy, logos and brand strategy aren’t
            included; if you have new material, I’ll place it.
          </p>
        </section>
        <section aria-labelledby="how">
          <h2 class="eyebrow" id="how">04 How it works</h2>
          <ol class="rows steps" role="list">
            {steps.map((step) => <li>{step}</li>)}
          </ol>
          <p class="prose">50% to start, 40% on approval, 10% at launch.</p>
        </section>
      </div>
    </div>

    <div class="band toned">
      <div class="wrap columns">
        <div class="facts">
          <section aria-labelledby="pricing">
            <h2 class="eyebrow" id="pricing">05 Pricing</h2>
            <p class="statement">Projects from $7,500.</p>
            <p class="prose quote">
              You get a fixed quote after a short call, once you’ve seen your homepage concept.
            </p>
            <p class="prose">Ongoing care is available after launch.</p>
          </section>
          <section aria-labelledby="about">
            <h2 class="eyebrow" id="about">06 About</h2>
            <div class="about-body">
              <div class="portrait">
                <Image
                  src={hiatt}
                  alt="Portrait of Hiatt Gafnea"
                  width={224}
                  height={280}
                  densities={[1, 2]}
                  fit="cover"
                  position="center"
                  format="webp"
                />
              </div>
              <p class="prose">
                I’m Hiatt Gafnea. I started Celnu in Greensboro to build websites for private
                investment firms. I studied business at UNCG’s Bryan School, and I care as much about
                what your site tells an owner or a banker as how it looks. When you work with Celnu,
                you work with me: I do the research, the design and the build, and I answer my own
                email. I’m in Greensboro and glad to meet in person anywhere in North Carolina.
              </p>
            </div>
          </section>
        </div>
        <section aria-labelledby="closing">
          <h2 class="feature closing-title" id="closing">
            Send your URL. <span class="closing-line">I’ll show you what it could be.</span>
          </h2>
          <UrlField id="url-closing" />
        </section>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <span>Greensboro, NC</span>
      <span>© {year} Celnu</span>
    </div>
  </footer>
</Base>

<script>
  // Without JavaScript the link jumps to #send. With it, the cursor goes straight in the field;
  // letting the jump run too would pull focus back out.
  document.querySelector('[data-jump-to-field]')?.addEventListener('click', (event) => {
    event.preventDefault();
    document.getElementById('url-hero')?.focus();
  });
</script>

<style>
  .wrap {
    max-width: calc(90rem + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .skip {
    position: absolute;
    top: 0.5rem;
    left: var(--gutter);
    padding: 0.5rem 0.75rem;
    background: var(--paper);
    transform: translateY(-200%);
  }

  .skip:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }

  /* Header */
  .site-header {
    padding-block: 1.25rem;
  }

  .header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.875rem;
    line-height: 1;
  }

  /* Hero */
  .hero {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 5.5vw, 5rem);
  }

  /* Two lines on most phones (three at 320px), so the offer shows sooner; still the largest type. */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 14.5vw - 0.25rem, 7rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .subline {
    max-width: 38rem;
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    font-size: 1.125rem; /* 18px */
    text-wrap: pretty;
  }

  /* The free concept leads into the form, so it's set apart from the promise by weight, not size. */
  .offer {
    max-width: 38rem;
    margin-top: 1rem;
    font-size: 1.125rem;
    font-weight: 600;
    text-wrap: pretty;
  }

  .hero-field {
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    scroll-margin-top: 1.5rem;
  }

  /* For partners who already have a concept: quieter than the form, and not a link. */
  .reply {
    max-width: 34rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    border-top: 1px solid var(--rule);
    text-wrap: pretty;
  }

  /* Bands */
  .band {
    padding-block: clamp(3rem, 5.5vw, 5rem);
  }

  .accent {
    color: var(--paper);
    background: var(--accent);
  }

  .toned {
    background: var(--paper-2);
  }

  .columns {
    display: grid;
    gap: 3rem clamp(2.5rem, 5vw, 4.5rem);
  }

  .statement,
  .feature,
  .rows {
    font-family: var(--font-display);
    font-weight: 400;
  }

  .statement {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 1.9rem + 0.8vw, 2.625rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  /* The hook is the center of the page, so it gets the largest type after the hero. */
  .feature {
    margin-top: 1rem;
    font-size: clamp(2.75rem, 2rem + 1.9vw, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }

  .prose {
    max-width: 38rem;
    margin-top: 1rem;
    font-size: 1.125rem;
    text-wrap: pretty;
  }

  /* The firm number sits right under the starting price. */
  .quote {
    margin-top: 0.5rem;
  }

  /* Plain lists: no icons, just hairlines */
  .rows {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    font-size: clamp(1.625rem, 1.4rem + 0.8vw, 2rem);
    line-height: 1.15;
    border-top: 1px solid var(--ink);
  }

  .rows li {
    padding-block: 0.4375rem 0.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .steps {
    counter-reset: step;
  }

  .steps li {
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr);
    align-items: center;
    padding-block: 0.25rem 0.5rem;
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    font-size: clamp(4.5rem, 3.75rem + 2.2vw, 6rem);
    line-height: 1;
  }

  /* Final band */
  .facts {
    display: grid;
    gap: 2.5rem;
    align-content: start;
  }

  .about-body {
    display: grid;
    align-items: start;
    gap: 1rem;
    margin-top: 1rem;
  }

  .about-body .prose {
    margin-top: 0;
  }

  .portrait {
    max-width: 14rem;
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .closing-title {
    margin-top: 0;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .closing-line {
    display: block;
  }

  /* Footer */
  .site-footer {
    padding-block: 1.5rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
  }

  /* The portrait sits beside the bio once there's room; on a phone it stacks above. */
  @media (min-width: 30rem) {
    .about-body {
      grid-template-columns: min(35%, 14rem) minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  /* Every band shares one center line from here up; below it, everything stacks. */
  @media (min-width: 64rem) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Sized so the headline holds two lines in its half of the page. */
    .hero-title {
      font-size: clamp(4rem, 6.8vw, 6.625rem);
    }
  }
</style>
