---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../config';

const year = new Date().getFullYear();
---

<Base
  title="Celnu — Websites for private investment firms"
  description="I design and build websites for private investment firms. This site is down for maintenance and will be back soon."
>
  <div class="page">
    <header class="wrap">
      <span class="wordmark">Celnu</span>
    </header>

    <main class="wrap">
      <h1 class="title">This site is under maintenance.</h1>
      <p class="prose">
        I’m making updates to celnu.com, and it will be back soon. In the meantime, you can reach me
        at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
      <p class="reply">Already received a concept from me? Reply to my email as usual.</p>
    </main>

    <footer class="wrap footer">
      <span>Greensboro, NC</span>
      <span>© {year} Celnu</span>
    </footer>
  </div>
</Base>

<style>
  /* The same tokens and type as the full page, cut down to one notice. */
  .page {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100svh;
  }

  .wrap {
    width: 100%;
    max-width: calc(90rem + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  header {
    padding-block: 1.25rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.875rem;
    line-height: 1;
  }

  main {
    align-self: center;
    padding-block: 3rem 5rem;
  }

  .title {
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 5vw, 6.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .prose {
    max-width: 38rem;
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    font-size: 1.125rem;
    text-wrap: pretty;
  }

  .reply {
    max-width: 38rem;
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
    padding-block: 1.5rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
</style>
